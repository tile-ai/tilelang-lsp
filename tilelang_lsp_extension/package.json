{
  "name": "tilelang-type-decorator",
  "displayName": "TileLang Type Decorator",
  "description": "Language support for TileLang: inlay hints for buffer shapes, dtypes, and scopes.",
  "icon": "assets/icon.png",
  "publisher": "tileAI-tilelangLSP-project",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "TileLang LSP",
      "properties": {
        "tilelang.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter that has the tlsp package installed."
        },
        "tilelang.enableInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints for TileLang buffer allocations."
        },
        "tilelang.serverArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional arguments to pass to the TileLang LSP server."
        },
        "tilelang.target": {
          "type": "string",
          "default": "cuda",
          "enum": [
            "cuda",
            "c",
            "llvm",
            "metal",
            "webgpu"
          ],
          "description": "Compilation target used when analyzing kernels (LayoutInference runs up to this target). Use 'c' on machines without a GPU toolchain."
        }
      }
    },
    "grammars": [
      {
        "path": "./syntaxes/tilelang-injection.tmLanguage.json",
        "scopeName": "tilelang-injection.python",
        "injectTo": [
          "source.python"
        ],
        "embeddedLanguages": {}
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.18.0",
    "@types/vscode": "^1.75.0",
    "eslint": "^10.8.0",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.65.0",
    "vsce": "^2.15.0"
  }
}
